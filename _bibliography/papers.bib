@article{tsarin2025poled,
  abbr      = {Database},
  title     = {PolED: a manually curated database of functional studies of <i>POLE</i> and <i>POLD1</i> variants reported in humans}, 
  author    = {Tsarin, Lev and Shcherbakova, Polina V.},
  journal   = {Database},
  volume    = {2025},
  pages     = {baaf076},
  year      = {2025},
  month     = jan,
  doi       = {10.1093/database/baaf076},
  html      = {https://doi.org/10.1093/database/baaf076},
  pmid      = {41263451},
  website   = {https://poled-db.org},
  abstract  = {Human <i>POLE</i> and <i>POLD1</i> genes encode DNA polymerases responsible for genome replication and proofreading of DNA synthesis errors. Germline and somatic <i>POLE/POLD1</i> mutations compromising the polymerase fidelity cause cancers with high mutational burden. Ultramutation is associated with a better prognosis and immunotherapy response, highlighting the need to define tumour <i>POLE/POLD1</i> status unambiguously. Prior studies assessed the functional significance of numerous <i>POLE/POLD1</i> variants in experimental models. However, the data remain scattered and difficult to evaluate by non-specialists, limiting their utility for research and clinical applications. Through manual literature curation, we integrated data from functional studies of clinically relevant <i>POLE</i> and <i>POLD1</i> variants into PolED, a publicly available database. PolED compiles information on variant effects in biochemical assays, yeast, mammalian cells, and mouse tumour models along with supporting references. It also includes a concise summary of functional significance for each variant. PolED aims to assist in clinical decision-making, guide personalized therapy, and promote further research.},
  selected  = {true},
  preview   = {poled-preview.png},
  altmetric = {true},
  dimensions= {true}
}
@inproceedings{tsarin2026ultramutator,
  abbr         = {Poster},
  title        = {Machine learning framework to identify tumors with ultramutator DNA polymerase &epsilon; variants from targeted sequencing data},
  author       = {Tsarin, Lev and Shcherbakova, Polina V.},
  booktitle    = {25th Annual Midwest DNA Repair Symposium},
  address      = {Kansas, USA},
  year         = {2026},
  selected     = {false},
  abstract     = {Targeted sequencing panels cover too little of the genome for classical mutational signature analysis, making ultramutated tumours hard to identify in the assays most patients actually receive. We build machine learning classifiers on AACR GENIE targeted-panel data that separate POLE driver from passenger mutations across panels of differing composition, using features engineered from mutation context. The framework also nominates candidate novel driver variants for functional follow-up.}
}
